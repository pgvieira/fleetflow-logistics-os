{
  "name": "fleetflow-logistics-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.21.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @fleetflow/api",
    "dev:web": "npm run dev --workspace @fleetflow/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "audit": "npm audit --audit-level=low",
    "check:pre-push": "npm run typecheck && npm run lint && npm test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "husky": "^9.1.7"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true,
    "unrs-resolver": true
  }
}
