{
	"name": "fleetflow-logistics-os",
	"private": true,
	"version": "0.0.4",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"prepare": "husky",
		"test": "vitest",
		"test:ui": "vitest ui",
		"type-check": "tsc --noEmit",
		"security-check": "npm audit --audit-level=critical"
	},
	"lint-staged": {
		"**/*": "prettier --write --ignore-unknown"
	},
	"dependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/babel__core": "^7.20.5",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/ui": "^5.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"eslint": "^10.10.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.5.1",
		"msw": "^2.15.0",
		"prettier": "3.9.8",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"allowScripts": {
		"msw@2.15.0": true
	}
}
